# Otto's inventory controls. Explicit positions prevent new buttons overlapping an older saved layout.
{
  sidebar: {
    enabled: true
    position: "top_left"
    buttons: {
      "ftblibrary:toggle/gamemode": { enabled: false, x: 0, y: 0 }
      "ftblibrary:toggle/day": { enabled: true, x: 1, y: 0 }
      "ftblibrary:toggle/night": { enabled: true, x: 2, y: 0 }
      "ftblibrary:toggle/rain": { enabled: true, x: 3, y: 0 }
      "sf3extras:difficulty/peaceful": { enabled: true, x: 0, y: 1 }
      "sf3extras:difficulty/easy": { enabled: true, x: 1, y: 1 }
      "sf3extras:difficulty/normal": { enabled: true, x: 2, y: 1 }
      "sf3extras:difficulty/hard": { enabled: true, x: 3, y: 1 }
      "ftbessentials:trash_can": { enabled: true, x: 0, y: 2 }
      "ftblibrary:config": { enabled: true, x: 1, y: 2 }
      "sf3extras:save": { enabled: true, x: 2, y: 2 }
      "ftbteams:my_team": { enabled: true, x: 0, y: 3 }
      "ftbteams:team_lives": { enabled: true, x: 1, y: 3 }
      "ftbchunks:chunks": { enabled: true, x: 2, y: 3 }
      "ftbchunks:claim_chunks": { enabled: true, x: 3, y: 3 }
    }
  }
}
